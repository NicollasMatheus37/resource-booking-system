# 12-Factor III — toda configuração vem do ambiente.
# Copie para .env (que NUNCA é commitado) e ajuste conforme necessário.

# ---- Postgres (usado pelo container do banco) ----
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# ---- API ----
# Sem default na aplicação: ausente, o processo derruba no boot.
#
# ATENÇÃO: este valor é para desenvolvimento LOCAL, fora do Docker — por isso
# `localhost`. Dentro do compose, o host é o nome do serviço (`postgres`), e a
# URL é montada no próprio compose.yaml a partir das variáveis POSTGRES_*.
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking
PORT=3000
NODE_ENV=production
CORS_ORIGINS=http://localhost:4200

# Janela de slot e horizonte da agenda (ADR 0003).
SLOT_DURATION_MINUTES=30
SCHEDULE_HORIZON_DAYS=7

# Fuso de OPERAÇÃO dos recursos. A jornada abaixo é horário de parede local:
# uma sala funciona das 8h às 18h no relógio de quem a usa, não em UTC.
SCHEDULE_TIMEZONE=America/Sao_Paulo
SCHEDULE_DAY_START_HOUR=8
SCHEDULE_DAY_END_HOUR=18

# ---- Frontend ----
# Injetado em runtime no env.js. É público por natureza — nunca coloque
# segredo aqui (ver "Segurança do env.js" no ADR 0010).
PUBLIC_API_URL=http://localhost:3000/api
